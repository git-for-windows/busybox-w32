. ./testing.sh

# testing "test name" "command" "expected result" "file input" "stdin"

cat <<EOF > head.input
line 1
line 2
line 3
line 4
line 5
line 6
line 7
line 8
line 9
line 10
line 11
line 12
EOF

testing "head (without args)" \
	"head head.input" \
	"line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\n" \
	"" ""

testing "head -n <positive number>" \
	"head -n 2 head.input" \
	"line 1\nline 2\n" \
	"" ""

testing "head reports stdin read errors" \
	"head 0>/dev/null 2>/dev/null; echo status=\$?" \
	"status=1\n" \
	"" ""

testing "head reports buffered output errors" \
	"\"\$bindir/busybox\" head head.input 1<head.input 2>/dev/null; \
	echo status=\$?" \
	"status=1\n" \
	"" ""

optional ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK
testing "head resets stdin state between NOFORK invocations" \
	"\"\$bindir/busybox\" ash -c 'head -n1 <head.input; \
	head -n1 <head.input'" \
	"line 1\nline 1\n" \
	"" ""
SKIP=

optional ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK FEATURE_FANCY_HEAD
testing "head reuses stdin stream within one invocation" \
	"\"\$bindir/busybox\" ash -c 'head -q -n1 - - <input'" \
	"line 1\nline 2\n" \
	"line 1\nline 2\n" ""

testing "head reports NOFORK output errors with circular buffers" \
	"\"\$bindir/busybox\" ash -c ' \
	head -n -1 <head.input 1<head.input 2>/dev/null; echo status=\$?; \
	head -c -1 <head.input 1<head.input 2>/dev/null; echo status=\$?; \
	head -n1 <head.input; echo status=\$?'" \
	"status=1\nstatus=1\nline 1\nstatus=0\n" \
	"" ""
SKIP=

optional ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK FEATURE_FANCY_HEAD PRINTF
testing "head reports NOFORK output errors before final flush" \
	"printf '%65536s' '' >head.large; \
	\"\$bindir/busybox\" ash -c ' \
	head -c 65536 <head.large 1<head.large 2>/dev/null; echo status=\$?; \
	head -n1 <head.input; echo status=\$?'; \
	rm head.large" \
	"status=1\nline 1\nstatus=0\n" \
	"" ""
SKIP=

optional FEATURE_FANCY_HEAD
testing "head -n <negative number>" \
	"head -n -9 head.input" \
	"line 1\nline 2\nline 3\n" \
	"" ""
SKIP=

rm head.input

exit $FAILCOUNT
