. ./testing.sh

test -f "$bindir/.config" && . "$bindir/.config"

# testing "test name" "options" "expected result" "file input" "stdin"

optional PLATFORM_MINGW32
# Test case
testing "shebang" \
	"uudecode; sh -c './shebang.sh'; echo \$?" \
	"Hello world
0
" \
"" "\
begin-base64 755 shebang.sh
IyEvYmluL3NoCmVjaG8gIkhlbGxvIHdvcmxkIgo=
====
"
rm -f shebang.sh

# Test case
testing "shebang with whitespace" \
	"uudecode; sh -c './shebang_trailing_space.sh'; echo \$?" \
	"Hello world
0
" \
"" "\
begin-base64 755 shebang_trailing_space.sh
IyEvYmluL3NoIAplY2hvICJIZWxsbyB3b3JsZCIK
====
"
rm -f shebang_trailing_space.sh

# Test case
testing "shebang with argument" \
	"uudecode; sh -c './shebang_argument.sh'; echo \$?" \
	"Hello world
0
" \
"" "\
begin-base64 755 shebang_argument.sh
IyEvYmluL3NoIC0KZWNobyAiSGVsbG8gd29ybGQiCg==
====
"
rm -f shebang_argument.sh

# Test case
testing "shebang with leading whitespace and argument" \
       "uudecode; sh -c './shebang_leading_space_argument.sh'; echo \$?" \
       "Hello world
0
" \
"" "\
begin-base64 755 shebang_leading_space_argument.sh
IyEvYmluL3NoICAtCmVjaG8gIkhlbGxvIHdvcmxkIgo=
====
"
rm -f shebang_leading_space_argument.sh

# Test case
testing "shebang with argument and trailing whitespace" \
	"uudecode; sh -c './shebang_argument_trailing_space.sh'; echo \$?" \
	"Hello world
0
" \
"" "\
begin-base64 755 shebang_argument_trailing_space.sh
IyEvYmluL3NoIC0gCmVjaG8gIkhlbGxvIHdvcmxkIgo=
====
"
rm -f shebang_argument_trailing_space.sh

# Test case
testing "shebang with leading whitespace, argument and trailing whitespace" \
       "uudecode; sh -c './shebang_leading_argument_trailing_space.sh'; echo \$?" \
       "Hello world
0
" \
"" "\
begin-base64 755 shebang_leading_argument_trailing_space.sh
IyEvYmluL3NoICAtIAplY2hvICJIZWxsbyB3b3JsZCIK
====
"
rm -f shebang_leading_argument_trailing_space.sh

testing "sh remove CRs from string being evaluated" \
	"sh -c \"$(printf 'set -e\r\necho Hello world\r\n')\"" \
	"Hello world\n" "" ""

testing "sh preserve lone CRs during field splitting" \
	"sh input" \
	"Hello\r world\n" "echo \$(printf \"Hello\\\\r\\\\r\\\\nworld\\\\r\\\\n\")" ""

testing "sh read with CRLF" \
	"printf '1 2\\r\\n' | { read var; printf \"\${var}\\\\n\"; }" \
	"1 2\n" "" ""

testing "sh read with CR" \
	"printf '1\\r2\\r\\n' | { read var; printf \"\${var}\\\\n\"; }" \
	"1\r2\n" "" ""

testing "sh read with \\CRLF" \
	"printf '1\\\\\r\\n2\\r\\n' | { read var; printf \"\${var}\\\\n\"; }" \
	"12\n" "" ""

testing "sh read with \\CR" \
	"printf '1\\\\\r2\\r\\n' | { read var; printf \"\${var}\\\\n\"; }" \
	"1\r2\n" "" ""

testing "sh restores a redirected script fd" \
	"echo 'echo 13>file; rm file' >redir-script; \
	BUSYBOX=\"\$bindir/busybox\"; export BUSYBOX; \
	\"\$BUSYBOX\" ash -c 'exec 10</dev/null 11</dev/null 12</dev/null; \
	\"\$BUSYBOX\" ash redir-script'; test ! -e file" \
	"\n" "" ""
rm -f redir-script file

testing "sh expands ordinary variables in pipeline commands" \
	"value='hello world'; echo 'hello world' | grep -F \"\$value\"" \
	"hello world\n" "" ""

testing "sh expands variable lengths in pipeline commands" \
	"value=hello; echo 5 | grep -F \"\${#value}\"" \
	"5\n" "" ""

testing "sh isolates assigning pipeline expansions" \
	"unset value; \
	\"\$bindir/busybox.exe\" true \"\${value:=after}\" | cat; \
	printf '<%s>\\n' \"\${value-unset}\"" \
	"<unset>\n" "" ""

testing "sh isolates dynamic pipeline variables" \
	"RANDOM=123; \"\$bindir/busybox.exe\" true \"\$RANDOM\" | cat; \
	after=\$RANDOM; RANDOM=123; expected=\$RANDOM; \
	test \"\$after\" = \"\$expected\"" \
	"" "" ""

testing "sh isolates nounset pipeline expansion errors" \
	"sh -c 'set -u; \
	\"\$bindir/busybox.exe\" true \"\$missing\" | cat; \
	echo survived' 2>/dev/null" \
	"survived\n" "" ""

testing "sh expands simple pipeline arithmetic" \
	"start=1; len=3; printf abcdef | \
	cut -c\$((start + 1))-\$((start + \$len))" \
	"bcd\n" "" ""

cat >arithmetic-spawn-script.sh <<'EOF'
a=1
"$bindir/busybox.exe" ash -c '
	test "$PPID" = "$1" || exit 1
	shift
	printf "%s\n" "$@"
' child "$$" "$((a + 1))" "$(($a + 1))" "$((${a} + 1))" | cat
EOF
optional PLATFORM_MINGW32 ASH FEATURE_SH_MATH ASH_TEST ASH_PRINTF
testing "sh directly spawns arithmetic variable expansions" \
	"\"\$bindir/busybox.exe\" ash arithmetic-spawn-script.sh" \
	"2\n2\n2\n" "" ""
rm -f arithmetic-spawn-script.sh
optional PLATFORM_MINGW32

testing "sh isolates assigning pipeline arithmetic" \
	"value=1; \
	\"\$bindir/busybox.exe\" true \"\$((value += 1))\" | cat; \
	printf '%s\\n' \"\$value\"" \
	"1\n" "" ""

testing "sh isolates dynamic pipeline arithmetic" \
	"RANDOM=123; \
	\"\$bindir/busybox.exe\" true \"\$((RANDOM + 1))\" | cat; \
	after=\$RANDOM; RANDOM=123; expected=\$RANDOM; \
	test \"\$after\" = \"\$expected\"" \
	"" "" ""

testing "sh isolates pipeline arithmetic errors" \
	"sh -c '\"\$bindir/busybox.exe\" true \"\$((1 / 0))\" | cat; \
	echo survived' 2>/dev/null" \
	"survived\n" "" ""

testing "sh isolates invalid pipeline arithmetic" \
	"sh -c '\"\$bindir/busybox.exe\" true \"\$((08))\" | cat; \
	echo survived' 2>/dev/null" \
	"survived\n" "" ""

optional PLATFORM_MINGW32 ASH FEATURE_SH_MATH ASH_ECHO CAT
testing "sh isolates signed pipeline arithmetic substitutions" \
	"sh -c 'a=3; x=-1; \
	\"\$bindir/busybox.exe\" true \"\$((a-\$x))\" | cat; \
	x=+1; \"\$bindir/busybox.exe\" true \"\$((a+\$x))\" | cat; \
	echo survived' 2>/dev/null" \
	"survived\n" "" ""

optional PLATFORM_MINGW32
testing "sh retains tracing for simple pipeline commands" \
	"echo 'set -x; \"\$bindir/busybox.exe\" true hello | cat' \
		>xtrace-script.sh; \
	trace=\$(\"\$bindir/busybox.exe\" ash xtrace-script.sh \
		2>&1 1>/dev/null); \
	echo \"\$trace\" | grep -F 'true hello' >/dev/null && \
	echo \"\$trace\" | grep -F '+ cat' >/dev/null && \
	echo traced" \
	"traced\n" "" ""
rm -f xtrace-script.sh

cat >xtrace-state-script.sh <<'EOF'
unset leaked
PS4='${leaked:=changed}> '
set -x
"$bindir/busybox.exe" true | cat
set +x -- "${leaked-unset}"
printf '%s\n' "$1"
unset leaked observed
set -x
output=$("$bindir/busybox.exe" true) observed=${leaked-unset}
set +x
printf '%s\n' "$observed"
EOF
optional PLATFORM_MINGW32 ASH ASH_EXPAND_PRMT ASH_PRINTF
testing "sh keeps pipeline and substitution PS4 effects in children" \
	"\"\$bindir/busybox.exe\" ash xtrace-state-script.sh 2>/dev/null" \
	"unset\nunset\n" "" ""
rm -f xtrace-state-script.sh

cat >suffix-script.sh <<'EOF'
mode=$1
PATH="$PWD/suffix-bin:$PATH"
for command in busybox-suffix ./suffix-bin/busybox-suffix \
	"$PWD/suffix-bin/busybox-suffix"; do
	set -- "$command" ash -c 'test "$PPID" = "$1" && echo direct' child "$$"
	case "$mode" in
	simple)
		"$@"
		:
		;;
	pipeline)
		"$@" | cat
		;;
	substitution)
		output=$("$@")
		printf '%s\n' "$output"
		;;
	esac
done
EOF
optional PLATFORM_MINGW32 ASH ASH_TEST ASH_ECHO ASH_PRINTF
testing "sh finds a directly spawned command's .exe suffix" \
	"mkdir suffix-bin && \
	cp \"\$bindir/busybox.exe\" suffix-bin/busybox-suffix.exe && \
	\"\$bindir/busybox.exe\" ash suffix-script.sh pipeline" \
	"direct\ndirect\ndirect\n" "" ""

testing "sh finds a directly spawned simple command's .exe suffix" \
	"\"\$bindir/busybox.exe\" ash suffix-script.sh simple" \
	"direct\ndirect\ndirect\n" "" ""
rm -rf suffix-bin suffix-script.sh

optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK WHICH
testing "sh keeps which's standalone-shell context in a pipeline" \
	"\"\$bindir/busybox.exe\" ash -c 'which /bin/cat | cat'" \
	"cat\n" "" ""

testing "sh keeps which's standalone-shell context as a simple command" \
	"\"\$bindir/busybox.exe\" ash -c 'which /bin/cat; true'" \
	"cat\n" "" ""

optional PLATFORM_MINGW32 ASH ASH_ECHO
testing "sh continues after an empty batch file" \
	": >empty-batch-pr17.bat; \
	\"\$bindir/busybox.exe\" ash -c \
	'./empty-batch-pr17.bat; echo status=\$?; echo survived'; \
	rm -f empty-batch-pr17.bat" \
	"status=0\nsurvived\n" "" ""

optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK WHICH
testing "sh does not trace a fast-path fallback command twice" \
	"echo 'set -x; which /bin/cat | cat' >which-trace-script.sh; \
	trace=\$(\"\$bindir/busybox.exe\" ash which-trace-script.sh \
		2>&1 1>/dev/null); \
	echo \"\$trace\" | grep -c '^+ which /bin/cat\$'" \
	"1\n" "" ""
rm -f which-trace-script.sh

optional PLATFORM_MINGW32
testing "sh survives an empty pipeline command word" \
	"\"\$bindir/busybox.exe\" ash -c \
	'unset empty; \$empty | cat; echo survived \$?'" \
	"survived 0\n" "" ""

optional PLATFORM_MINGW32 ASH ASH_ECHO CAT
testing "sh continues after an empty batch pipeline" \
	": >empty-batch-pr17.bat; \
	\"\$bindir/busybox.exe\" ash -c \
	'./empty-batch-pr17.bat | cat; echo status=\$?; echo survived'; \
	rm -f empty-batch-pr17.bat" \
	"status=0\nsurvived\n" "" ""

optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK \
	EXPR EXPR_MATH_SUPPORT_64
testing "sh survives NOFORK expr division overflow" \
	"\"\$bindir/busybox.exe\" ash -c ' \
	expr -9223372036854775808 / -1; \
	echo status=\$?; echo survived' 2>&1" \
	"expr: arithmetic overflow\nstatus=2\nsurvived\n" "" ""

testing "sh survives NOFORK expr remainder overflow" \
	"\"\$bindir/busybox.exe\" ash -c ' \
	expr -9223372036854775808 % -1; \
	echo status=\$?; echo survived'" \
	"0\nstatus=1\nsurvived\n" "" ""

optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK \
	FEATURE_CATN
testing "sh keeps stdin usable after NOFORK cat -n" \
	"printf 'one\\ntwo\\n' | \
	\"\$bindir/busybox.exe\" ash -c 'cat -n; cat; echo status=\$?'" \
"\
     1	one
     2	two
status=0
" "" ""
optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK \
	FEATURE_CATN
testing "sh reports cat -n write failures under NOFORK" \
	"\"\$bindir/busybox.exe\" ash -c \
	'cat -n <<< hi 1>&-; echo status=\$?' 2>&1" \
	"cat: standard output: Bad file descriptor\nstatus=1\n" "" ""
optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK \
	FEATURE_CATV
testing "sh reports cat -v write failures under NOFORK" \
	"\"\$bindir/busybox.exe\" ash -c \
	'cat -v <<< hi 1>&-; echo status=\$?' 2>&1" \
	"cat: standard output: Bad file descriptor\nstatus=1\n" "" ""
optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK
testing "sh reports wc write failures under NOFORK" \
	"\"\$bindir/busybox.exe\" ash -c \
	'wc -l <<< hi 1>&-; echo status=\$?' 2>&1" \
	"wc: standard output: Bad file descriptor\nstatus=1\n" "" ""
optional PLATFORM_MINGW32

for marker in good bad; do
	mkdir "interp-path-$marker"
	printf '#!/bin/ash\necho %s\n' "$marker" \
		>"interp-path-$marker/pr17-path-interpreter"
	chmod +x "interp-path-$marker/pr17-path-interpreter"
done
printf '#!/usr/bin/pr17-path-interpreter\n' >interp-path-launch
chmod +x interp-path-launch
cat >interp-path-script.sh <<'EOF'
if test "$1" = good; then
	PATH="$PWD/interp-path-good"
	export PATH
else
	unset PATH
fi
./interp-path-launch 2>/dev/null
printf 'status=%s\n' "$?"
EOF
optional PLATFORM_MINGW32 ASH FEATURE_PREFER_APPLETS ASH_TEST ASH_ECHO \
	ASH_PRINTF
testing "sh resolves interpreters using the exported PATH" \
	"PATH=\"\$PWD/interp-path-bad:\$PATH\" \
	\"\$bindir/busybox.exe\" ash interp-path-script.sh good" \
	"good\nstatus=0\n" "" ""

testing "sh does not inherit the process PATH when PATH is unset" \
	"PATH=\"\$PWD/interp-path-bad:\$PATH\" \
	\"\$bindir/busybox.exe\" ash interp-path-script.sh missing" \
	"status=127\n" "" ""
rm -rf interp-path-good interp-path-bad interp-path-launch interp-path-script.sh
optional PLATFORM_MINGW32

mkdir -p comspec-probe/usr/bin
printf '#!/bin/ash\necho wrapper\n' >comspec-probe/usr/bin/cmd
printf '#!/bin/ash\necho stale\n' >comspec-stale
chmod +x comspec-probe/usr/bin/cmd comspec-stale
optional PLATFORM_MINGW32 ASH FEATURE_PREFER_APPLETS ASH_ECHO
testing "sh respects an unset COMSPEC when invoking the cmd wrapper" \
	"COMSPEC=\"\$PWD/comspec-stale\" \"\$bindir/busybox.exe\" ash -c \
	'unset COMSPEC; ./comspec-probe/usr/bin/cmd; :'" \
	"wrapper\n" "" ""

testing "sh respects an empty COMSPEC when invoking the cmd wrapper" \
	"\"\$bindir/busybox.exe\" ash -c \
	'COMSPEC=; ./comspec-probe/usr/bin/cmd; :' 2>/dev/null" \
	"wrapper\n" "" ""

testing "sh respects an empty COMSPEC when executing the cmd wrapper" \
	"\"\$bindir/busybox.exe\" ash -c \
	'COMSPEC=; exec ./comspec-probe/usr/bin/cmd' 2>/dev/null" \
	"wrapper\n" "" ""
rm -rf comspec-probe comspec-stale
optional PLATFORM_MINGW32

case "$COMSPEC" in
*\\cmd.exe)
	testing "'cmd //c' works" \
	"cmd //c dir /b /w sh.tests" \
	"sh.tests\r
" \
	"" \
	""
	;;
esac

testing "CR in backticks is only eaten if preceding a NL" \
	"cr=\"\$(printf \\\\015)\"; printf %s \"\$cr\" | hexdump -C" \
	"00000000  0d                                                |.|
00000001
" \
	"" \
	""

optional PLATFORM_MINGW32 ASH FEATURE_SH_STANDALONE FEATURE_SH_NOFORK \
	ASH_ECHO ASH_PRINTF ASH_TEST CAT WC HEAD TR AWK \
	FEATURE_CATN FEATURE_CATV FEATURE_FANCY_HEAD
if test -z "$SKIP"; then
	. ./nofork_io.tests
fi

exit $FAILCOUNT
